<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="ViME" Manufacturer="Harukoto Project" Version="$(Version)"
           UpgradeCode="{FBE67FDF-D839-4334-B59C-E6AD97BDBF38}" Scope="perUserOrMachine">
    <Launch Condition='NOT ALLUSERS OR (ALLUSERS = "2" AND MSIINSTALLPERUSER = "1")'
            Message="ViME installs for the current Windows user." />
    <!-- MSI uses only the numeric version, so a prerelease and its stable build can match. -->
    <MajorUpgrade Schedule="afterInstallInitialize" AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of ViME is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(LicenseRtf)" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserPrograms" Name="Programs">
        <Directory Id="ViMEInstallFolder" Name="ViME" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="{9B164C9D-22CD-45DC-A192-F193642E4FE5}">
        <Shortcut Id="ViMEShortcut" Name="ViME" Target="[ViMEInstallFolder]vime.exe"
                  WorkingDirectory="ViMEInstallFolder" />
        <RegistryValue Root="HKCU" Key="Software\Harukoto Project\ViME" Name="StartMenuShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="ViME" Title="ViME">
      <Files Directory="ViMEInstallFolder" Include="!(bindpath.Payload)\**" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
